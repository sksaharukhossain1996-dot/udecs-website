rules_version = '2';


service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ['sksaharukhossain1996@gmail.com', 'ecommerceunickdigital@gmail.com'] && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 64 &&
             data.hsn is string && data.hsn.size() > 0 && data.hsn.size() <= 16 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string && (data.category in ['kitchen', 'sports', 'wholesale', 'industrial']) &&
             data.gstRate is number && (data.gstRate in [5, 12, 18, 28]);
    }

    function isValidInvestorLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.company is string && data.company.size() > 0 && data.company.size() <= 160 &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 120 &&
             data.phone is string && data.phone.size() > 5 && data.phone.size() <= 20 &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 120 &&
             data.amount is string && data.amount.size() <= 60 &&
             data.message is string && data.message.size() <= 1000 &&
             data.approved is bool && data.approved == false;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30 &&
             data.shippingAddress is string && data.shippingAddress.size() > 0 && data.shippingAddress.size() <= 500 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.orderStatus is string && (data.orderStatus in ['pending', 'processing', 'packed', 'shipped', 'delivered', 'cancelled']) &&
             data.paymentStatus is string && (data.paymentStatus in ['pending', 'paid', 'failed', 'refunded']) &&
             data.paymentMethod is string && (data.paymentMethod in ['payu', 'upi', 'card', 'netbanking', 'cod']);
    }

    function isValidInquiry(data) {
      return data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 150 &&
             data.contactPerson is string && data.contactPerson.size() > 0 && data.contactPerson.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    function isValidAuditLog(data) {
      return data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 1000;
    }

    // Health check and connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Product catalog
    // Search-only16 chunks. Live deployment is a separate reviewed migration.
    match /catalogSearchChunks/{chunkId} {
      allow read: if chunkId.matches('^(0[0-9]|1[0-5])$');
      allow create, update: if isAdmin() && chunkId.matches('^(0[0-9]|1[0-5])$')
        && request.resource.data.keys().hasOnly(['version','entries'])
        && request.resource.data.version == 1
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 2000;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Order writes only through authorized server transactions.
    match /orders/{orderId} {
      allow create, delete: if false;
      allow get: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
      // Staff can update fulfillment references only. Customer/price/payment/stock ownership is immutable.
      allow update: if isValidId(orderId) && isAdmin() && isValidOrder(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus','trackingNumber','courierName','updatedAt'])
        && incoming().orderStatus in ['pending','processing','packed','shipped','delivered']
        && existing().orderStatus != 'cancelled' && (incoming().orderStatus == 'pending' || existing().paymentMethod == 'cod' || existing().paymentStatus == 'paid');
    }
    match /orderRequests/{reference} {
      allow read, write: if false;
    }

    // Storefront CMS Texts
    match /siteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Official Company Profile
    match /company/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // B2B Wholesale Inquiries
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow get, update, delete: if isValidId(inquiryId) && isAdmin();
      allow list: if isHROwner();
    }

    // Audit Trail
    match /auditLogs/{logId} {
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Administrative Privileges
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // Investor Leads (invest.html public form)
    match /investorLeads/{leadId} {
      allow create: if isValidInvestorLead(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Pitch-deck download tokens (doc id is the random 48-hex secret; only approved docs unlock deck.html)
    match /deckTokens/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    // HR directory: only the two verified owner accounts. Admin documents do not grant HR access.
    function isHROwner() {
      return request.auth != null && request.auth.token.email_verified == true &&
        request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com'];
    }
    function validHREmployee(d,id) {
      return d.keys().hasAll(['id','name','email','phone','designation','department','baseSalary','joiningDate','role','status','createdAt','updatedAt']) &&
        d.keys().hasOnly(['id','name','email','phone','designation','department','baseSalary','joiningDate','role','status','createdAt','updatedAt']) &&
        d.id == id && id.matches('^EMP-[a-zA-Z0-9-]{10,80}$') &&
        d.name is string && d.name.size()>0 && d.name.size()<=120 &&
        d.email is string && d.email.size()<=120 &&
        d.phone is string && d.phone.size()<=24 &&
        d.designation is string && d.designation.size()>0 && d.designation.size()<=120 &&
        d.department is string && d.department.size()>0 && d.department.size()<=100 &&
        d.baseSalary is number && d.baseSalary>=0 && d.baseSalary<=10000000 &&
        d.joiningDate is string && d.joiningDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.role in ['manager','inventory','accountant'] && d.status == 'active' &&
        d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /hrEmployees/{employeeId} {
      allow get, list: if isHROwner();
      allow create: if isHROwner() && validHREmployee(request.resource.data,employeeId) && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isHROwner();
    }
// Merge inside /databases/{database}/documents, preserving every existing rule.
// Only verified owner emails may read the list. Each customer may access their own profile.
match /customers/{uid} {
  function customerListOwner(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com'];}
  function validContact() {
    let d=request.resource.data;
    return d.keys().hasOnly(['name','phone','email','gender','address','source','phoneVerified','noticeVersion','updatedAt'])
      && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
      && d.phone is string && d.phone.matches('^\\+?[0-9]{7,15}$')
      && d.email == request.auth.token.email
      && d.gender in ['female','male','other','prefer_not_to_say']
      && d.address is string && d.address.size()>=5 && d.address.size()<=500
      && d.source == 'mysa' && d.phoneVerified == false
      && d.noticeVersion == 'customer-profile-v2'
      && d.updatedAt == request.time;
  }
  allow create, update: if request.auth != null && request.auth.uid == uid
    && request.auth.token.email_verified == true && validContact();
  allow get: if customerListOwner() || (request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true);
  allow list: if customerListOwner();
  allow delete: if customerListOwner();
}

match /hrAttendance/{id} { function valid() { let d=request.resource.data; let e=get(/databases/$(database)/documents/hrEmployees/$(d.employeeId)).data; return isHROwner() && d.keys().hasOnly(['id','employeeId','employeeName','date','month','status','note','updatedBy','createdAt','updatedAt']) && d.id==id && id==d.employeeId+'_'+d.date && d.month==d.date[0:7] && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && d.status in ['present','half-day','absent','leave'] && d.note is string && d.note.size()<=500 && d.updatedBy==request.auth.uid && d.updatedAt==request.time && e.name==d.employeeName && e.status=='active'; } allow read: if isHROwner(); allow create: if valid() && request.resource.data.createdAt==request.time; allow update: if valid() && request.resource.data.createdAt==resource.data.createdAt; allow delete: if false; }match /b2bRegistrations/{uid} {
 function owner(){return request.auth!=null&&request.auth.token.email_verified==true&&request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com'];}
 function self(){return request.auth!=null&&request.auth.uid==uid&&request.auth.token.email_verified==true;}
 function valid(){let d=request.resource.data;return d.keys().hasOnly(['businessName','gstin','pan','deliveryAddress','email','status','noticeVersion','updatedAt','contactName','phone','phoneCountryCode','phoneNational','phoneVerified'])&&d.contactName is string&&d.contactName.size()>=2&&d.contactName.size()<=120&&d.phoneCountryCode is string&&d.phoneCountryCode.matches('^\\+[1-9][0-9]{0,3}$')&&d.phoneNational is string&&d.phoneNational.matches('^[0-9]{4,14}$')&&d.phone==d.phoneCountryCode+d.phoneNational&&d.phone.matches('^\\+[1-9][0-9]{6,14}$')&&d.phoneVerified==false&&d.businessName is string&&d.businessName.size()>=2&&d.businessName.size()<=160&&d.pan is string&&d.pan.matches('^[A-Z]{5}[0-9]{4}[A-Z]$')&&d.gstin is string&&d.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$')&&d.gstin[2:12]==d.pan&&d.deliveryAddress is string&&d.deliveryAddress.size()>=5&&d.deliveryAddress.size()<=500&&d.email==request.auth.token.email&&d.status=='pending'&&d.noticeVersion=='b2b-identity-v1'&&d.updatedAt==request.time;}
 allow get:if owner()||self();
 allow list:if owner();
 allow create:if self()&&valid();
 allow update:if (self()&&valid())||(owner()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])&&request.resource.data.status in ['approved','needs_changes']&&request.resource.data.reviewedAt==request.time);
 allow delete:if self()||owner();
}
    // Private owner CRM notes. Never edits source leads or customer/order data.
    match /crmFollowUps/{id} {
      function crmOwner() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com']; }
      function validCrm() { let d=request.resource.data; return d.keys().hasOnly(['source','sourceId','status','note','dueDate','updatedBy','updatedAt','revision']) && d.source in ['customers','orders','investorLeads','inquiries'] && d.sourceId is string && d.sourceId.size()>0 && d.sourceId.size()<=128 && id==d.source+'_'+d.sourceId && d.status in ['new','contacted','qualified','waiting','won','closed'] && d.note is string && d.note.size()<=3000 && d.dueDate is string && (d.dueDate=='' || d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) && d.updatedBy==request.auth.uid && d.updatedAt==request.time && d.revision is string && d.revision.size()>=20 && d.revision.size()<=80; }
      allow get,list: if crmOwner();
      allow create,update: if crmOwner() && validCrm();
      allow delete: if false;
    }
    match /erpExpenses/{id} {
      function expenseOwner() {return request.auth!=null && request.auth.token.email_verified==true && request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com'];}
      function validExpense() {let d=request.resource.data;return id.size()>=20 && id.size()<=80 && d.keys().hasOnly(['date','amountPaise','category','reference','note','currency','state','createdBy','createdAt']) && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.amountPaise is int && d.amountPaise>0 && d.amountPaise<=1000000000 && d.category in ['stock_purchase','shipping','salary','rent','utilities','marketing','tax','fees','other'] && d.reference is string && d.reference.size()<=120 && d.note is string && d.note.size()<=1000 && d.currency=='INR' && d.state=='recorded' && d.createdBy==request.auth.uid && d.createdAt==request.time;}
      allow get,list: if expenseOwner();
      allow create: if expenseOwner() && validExpense();
      allow update,delete: if false;
    }
    match /erpBankTransactions/{id} {
      function bankOwner(){return request.auth!=null && request.auth.token.email_verified==true && request.auth.token.email in ['sksaharukhossain1996@gmail.com','ecommerceunickdigital@gmail.com'];}
      function validBank(){let d=request.resource.data;return id.matches('^bank_[a-f0-9]{64}$') && d.keys().hasOnly(['date','description','debitPaise','creditPaise','reference','bankAlias','currency','source','classification','createdBy','createdAt']) && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.description is string && d.description.size()>0 && d.description.size()<=300 && d.debitPaise is int && d.creditPaise is int && d.debitPaise>=0 && d.creditPaise>=0 && d.debitPaise<=1000000000 && d.creditPaise<=1000000000 && ((d.debitPaise>0 && d.creditPaise==0)||(d.creditPaise>0 && d.debitPaise==0)) && d.reference is string && d.reference.size()<=120 && d.bankAlias is string && d.bankAlias.matches('^[a-zA-Z][a-zA-Z0-9 _-]{2,39}$') && d.currency=='INR' && d.source=='statement_csv' && d.classification=='unclassified' && d.createdBy==request.auth.uid && d.createdAt==request.time;}
      allow get,list: if bankOwner();
      allow create: if bankOwner() && validBank();
      allow update,delete: if false;
    }

  }
}
