{
  "name": "udecs-api",
  "account_id": "bfa14054934d0f067511f26979c971d4",
  "main": "worker-production/production.mjs",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "web_socket_auto_reply_to_close"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "WA_DEDUPE",
      "id": "232e6995ffc346879ac2109abf21784e"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "LISTING_AI_FREE_TIER": "confirmed",
    "WHATSAPP_ORDER_MODE": "off",
    "WHATSAPP_OWNER_TEST_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INQUIRY_INBOX",
        "class_name": "InquiryInbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "udecs-inquiry-v1",
      "new_sqlite_classes": [
        "InquiryInbox"
      ]
    }
  ],
  "services": [
    {
      "binding": "WA_ORDER_SERVICE",
      "service": "udecs-orders-api",
      "entrypoint": "WhatsAppOrders"
    }
  ]
}
